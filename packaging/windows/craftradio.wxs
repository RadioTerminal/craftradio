<?xml version="1.0" encoding="utf-8"?>
<!--
  CraftRadio MSI for WiX Toolset v5. package.ps1 builds it with the UI and Util extensions.
  It is a per-machine install with a setup wizard and a Start Menu shortcut.
  It installs craftradio.exe and craftradio-cli.exe.
  The UpgradeCode belongs to CraftRadio. Do not change it and do not use it for another app.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="CraftRadio"
      Manufacturer="CraftRadio contributors"
      Version="$(var.Version)"
      UpgradeCode="7BAF572C-F1CD-4E87-98BA-F14D81C8A6E5"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="CraftRadio: radio station automation and playout" Manufacturer="CraftRadio contributors" />
    <!-- Pre-releases of one X.Y.Z have the same MSI version. This lets each one replace the last. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of CraftRadio is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- An advertised shortcut to an .exe needs an icon id that ends in .exe (ICE50). -->
    <Icon Id="CraftRadioIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CraftRadioIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/RadioTerminal/craftradio" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/RadioTerminal/craftradio/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/RadioTerminal/craftradio/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="CraftRadio" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs into the folder of the previous version. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\CraftRadio" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="CraftRadio" Level="1">
      <ComponentGroupRef Id="CraftRadioFiles" />
    </Feature>

    <!-- WixUI_InstallDir without its licence page. The code is MIT OR Apache-2.0. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchCraftRadio"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- package.ps1 draws these bitmaps from the app icon. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version, with a pre-release tag. craftradio.en-us.wxl shows it on the pages. -->
    <Property Id="CraftRadioVersion" Value="$(var.DisplayVersion)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="CraftRadio $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch CraftRadio" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#CraftRadioExe]" />
    <!-- This action runs in the unelevated wizard, so the app starts as the user. -->
    <CustomAction Id="LaunchCraftRadio" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="CraftRadioFiles" Directory="INSTALLFOLDER">
      <Component Id="CraftRadioApp" Guid="CAA0481F-FD38-473A-8762-79D117B9398E">
        <File Id="CraftRadioExe" Source="$(var.BinDir)\craftradio.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="CraftRadio"
              Description="Radio station automation and playout" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="CraftRadioIcon.exe" IconIndex="0" />
        </File>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\craftradio.exe" Value="[#CraftRadioExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\CraftRadio" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>
      <Component Id="CraftRadioCli">
        <File Id="CraftRadioCliExe" Source="$(var.BinDir)\craftradio-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
