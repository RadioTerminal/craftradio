<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for software centres. package.sh replaces @VERSION@ and @DATE@. -->
<component type="desktop-application">
  <id>io.github.radioterminal.craftradio</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>CraftRadio</name>
  <summary>Radio station automation and playout</summary>
  <developer id="io.github.radioterminal">
    <name>CraftRadio contributors</name>
  </developer>
  <description>
    <p>
      CraftRadio runs a radio station. A playlist drives four decks and shows when each item
      starts, items can be pinned to an exact time, and a cartwall fires jingles over whatever
      is on air.
    </p>
    <ul>
      <li>Four decks with crossfades, cue points and pre-loading</li>
      <li>A main playlist plus named playlists woven in by rules</li>
      <li>Fixed-time events that land on time</li>
      <li>A cartwall for jingles and effects</li>
      <li>Output to the sound card and to Icecast</li>
      <li>Every action is a command, scriptable from a CLI and an MCP server</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.radioterminal.craftradio.desktop</launchable>
  <icon type="stock">io.github.radioterminal.craftradio</icon>
  <!-- Only url types that appstream 0.15 knows. CI validates on Ubuntu 22.04. -->
  <url type="homepage">https://github.com/RadioTerminal/craftradio</url>
  <url type="bugtracker">https://github.com/RadioTerminal/craftradio/issues</url>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <keywords>
    <keyword>radio</keyword>
    <keyword>playout</keyword>
    <keyword>broadcast</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#f2c9c9</color>
    <color type="primary" scheme_preference="dark">#7a1c25</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>craftradio</binary>
    <binary>craftradio-cli</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
