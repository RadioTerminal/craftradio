# Caddy in front of craftradio-server, for one host. Not yet checked through Caddy: see
# README.md, "Checked". The host name is invented; use your own.
#
# Caddy gets and renews the certificate for the host. The server listens on loopback
# (listen = "127.0.0.1:8080", trusted_proxy = "127.0.0.1" in its config).

radio.example.org {
	reverse_proxy 127.0.0.1:8080 {
		# Pass each piece of a stream on as it comes, instead of buffering the reply.
		flush_interval -1
		# Request bodies (the app's endless source push) must not be buffered either.
		# Caddy buffers them only when `request_buffers` is set, so it is left out here;
		# do not add it.
	}
}
